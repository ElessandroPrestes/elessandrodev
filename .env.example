# URL do backend Node. O padrão /api/chat usa o proxy do Vite em dev
# e o proxy do Nginx no container. Para chamar direto: http://127.0.0.1:3201/api/chat
VITE_CHAT_API_URL=/api/chat

# Parâmetros do cliente. O backend Node já faz retry, fallback e circuit breaker;
# por isso o padrão é 0 retries no navegador. Aumente apenas se souber o motivo.
VITE_LLM_MAX_RETRIES=0
VITE_LLM_TIMEOUT_MS=35000
VITE_LLM_BACKOFF_BASE_MS=500

# Em caso de erro, o cliente registra no console o X-Request-Id,
# X-Assistant-Stage e X-Assistant-Cache devolvidos pelo backend.
