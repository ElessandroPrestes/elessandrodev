# URL pública do Cloudflare Worker do assistente
VITE_CHAT_API_URL=https://elessandrodev-chat.elessandrodev.workers.dev

# Parâmetros de Resiliência (Universal SDD)
# Retries valem para rede, timeout e 5xx. 429 NÃO é retentado:
# o Worker já tenta o fallback (OpenRouter -> Workers AI) e devolve a mensagem final.
VITE_LLM_MAX_RETRIES=2
VITE_LLM_TIMEOUT_MS=30000
VITE_LLM_BACKOFF_BASE_MS=500
