# Chave da API do Google Gemini para o assistente de IA conversacional
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Configuração de Modelos (estáveis, sem dependência de latest)
VITE_GEMINI_PRIMARY_MODEL=gemini-3.5-flash
VITE_GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Parâmetros de Resiliência (Universal SDD)
VITE_LLM_MAX_RETRIES=2
VITE_LLM_TIMEOUT_MS=30000
VITE_LLM_BACKOFF_BASE_MS=500
