# URL pública do Cloudflare Worker do assistente
VITE_CHAT_API_URL=https://elessandrodev-chat.elessandrodev.workers.dev

# Parâmetros de Resiliência (Universal SDD)
# Retries valem para rede, timeout e 5xx. 429 NÃO é retentado:
# o Worker já tenta o fallback (OpenRouter -> Workers AI) e devolve a mensagem final.
# O timeout do cliente deve ser maior que WORKER_BUDGET_MS (padrão 25000 no Worker).
VITE_LLM_MAX_RETRIES=2
VITE_LLM_TIMEOUT_MS=35000
VITE_LLM_BACKOFF_BASE_MS=500

# Em caso de erro, o cliente registra no console o X-Request-Id,
# X-Assistant-Stage e X-Assistant-Cache devolvidos pelo backend.

# Cloudflare Worker. Em dev, coloque credenciais em .dev.vars.
# Em produção, configure-as como secrets do Worker. Não use prefixo VITE_.
OPENROUTER_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
VISITOR_HASH_SECRET=

# Variáveis do Worker. Os valores de produção são definidos em wrangler.toml.
ENABLE_CACHE=true
CACHE_TTL_SECONDS=86400
REDIS_TIMEOUT_MS=500
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_MS=60000
CHAT_RATE_LIMIT_MAX=10
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
WORKER_BUDGET_MS=25000
EMBEDDING_TIMEOUT_MS=5000
OPENROUTER_TIMEOUT_MS=8000
WORKERS_AI_TIMEOUT_MS=12000
# Deixe vazio para desabilitar a geração alternativa.
WORKERS_AI_MODEL=@cf/google/gemma-4-26b-a4b-it

# Comando npm run rag:warm. Use o endpoint publicado ou o de desenvolvimento
# e um Origin que esteja na lista ALLOWED_ORIGIN do Worker.
CHAT_WARMUP_URL=
CHAT_WARMUP_ORIGIN=
