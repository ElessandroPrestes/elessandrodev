# Credenciais locais para gerar o índice vetorial.
# Copie para .env.ingest e preencha. Nunca commite .env.ingest.

# Cloudflare Dashboard > Workers & Pages > Account ID
CLOUDFLARE_ACCOUNT_ID=

# Token com permissão de leitura/execução no Workers AI.
# Crie em Cloudflare Dashboard > My Profile > API Tokens.
CLOUDFLARE_API_TOKEN=

# Modelo de embeddings usado no índice e nas consultas.
EMBEDDING_MODEL=@cf/baai/bge-m3
