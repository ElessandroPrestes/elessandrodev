# Backend Node.js do assistente RAG.
# Copie para backend/.env e preencha. Nunca commite backend/.env.

NODE_ENV=development
HOST=0.0.0.0
PORT=3201
LOG_LEVEL=info
APP_VERSION=1.0.0-migration

# Origens permitidas para o frontend em desenvolvimento.
CORS_ORIGINS=http://localhost:5212,http://127.0.0.1:5212,http://elessandrodev.localhost
TRUST_PROXY=1

# Limites de entrada e de abuso.
REQUEST_BODY_LIMIT=4kb
QUESTION_MAX_LENGTH=500
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
CHAT_RATE_LIMIT_MAX=20

# Índice RAG existente. O backend lê o índice produzido pelo pipeline atual.
RAG_INDEX_PATH=../worker/rag/index.json
RAG_TOP_K=4
RAG_HYBRID_ALPHA=0.6
RAG_MIN_SCORE=0.45

# Embeddings.
# auto: usa Cloudflare BGE-M3 se houver credenciais; senão tenta OpenAI-compatible.
# cloudflare: @cf/baai/bge-m3 via API REST do Workers AI.
# openai-compatible: endpoint /embeddings (Ollama, vLLM, OpenAI etc.).
EMBEDDINGS_PROVIDER=auto
EMBEDDING_MODEL=@cf/baai/bge-m3
EMBEDDINGS_DIMENSIONS=1024
EMBEDDINGS_TIMEOUT_MS=10000
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Exemplo local com Ollama: http://127.0.0.1:11434/v1
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=bge-m3

# LLM: OpenRouter (compatível com a API OpenAI via LangChain.js).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODELS=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free
OPENROUTER_TIMEOUT_MS=15000
OPENROUTER_MAX_TOKENS=3000
LLM_TEMPERATURE=0.2
LLM_MAX_ATTEMPTS_PER_MODEL=2
LLM_TOTAL_BUDGET_MS=25000
LLM_MODE=openrouter
SITE_URL=http://localhost:5212
APP_TITLE=Elessandro Portfolio

# Circuit breaker por modelo/provedor.
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_MS=60000

# Cache em memória (positivo e negativo), por réplica.
ENABLE_CACHE=true
CACHE_TTL_SECONDS=86400
NEGATIVE_CACHE_TTL_SECONDS=60

SHUTDOWN_TIMEOUT_MS=10000
