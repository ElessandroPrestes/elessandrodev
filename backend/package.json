{
  "name": "elessandrodev-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "split:corpus": "tsx scripts/split-corpus.ts"
  },
  "dependencies": {
    "@langchain/core": "1.3.5",
    "@langchain/openai": "1.8.0",
    "@langchain/textsplitters": "1.0.2",
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.3",
    "helmet": "8.3.0",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "globals": "17.14.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
